<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cn.chyuan.ai</groupId>
  <artifactId>mcp-gateway-agent</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <repositories>
    <repository>
      <id>nexus-aliyun</id>
      <name>nexus-aliyun</name>
      <url>https://maven.aliyun.com/nexus/content/groups/public/</url>
      <releases/>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <properties>
        <spring-boot.version>4.1.1</spring-boot.version>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
  </properties>
  <developers>
    <developer>
      <name>chyuan</name>
      <email>184172133@qq.com</email>
      <organization>fuzhengwei</organization>
      <organizationUrl>https://github.com/fuzhengwei</organizationUrl>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
  </parent>
  <dependencyManagement>
    <dependencies>
      <!-- 平台共享依赖版本收敛（本地 mvn install 消费，见 platform-bom/） -->
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>platform-bom</artifactId>
        <version>1.0</version><!-- 1.2 的 protobuf 4.33.5 管理与 ADK 1.7 链冲突（G53），待解后升级 -->
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- springdoc-openapi 3.x（Boot 4 / Framework 7 适配线，D06） -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>3.1.1</version>
      </dependency>
      <!-- 依赖收敛 pin（SELFLOOP2 loop-228，enforcer requireUpperBoundDeps）：取传递链上界。
           loop-625：BOM 1.2 已补 retrofit 管理，但 1.2 的 protobuf 4.33.5 与 ADK 链冲突（G53），
           故 import 暂留 1.0、本地 pin 恢复；G53 解除后切 BOM 1.2 并删本地 pin -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.5.0-jre</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.retrofit2</groupId>
        <artifactId>retrofit</artifactId>
        <version>2.9.0</version>
      </dependency>
      <dependency>
        <groupId>org.checkerframework</groupId>
        <artifactId>checker-qual</artifactId>
        <version>3.49.0</version>
      </dependency>
      <!-- Retrofit2 2.9.0：loop-625 批一收编由 platform-bom 统一管理 -->
      <!-- 设计模式框架 -->
      <dependency>
        <groupId>cn.bugstack.wrench</groupId>
        <artifactId>xfg-wrench-starter-design-framework</artifactId>
        <version>3.0.0</version>
      </dependency>
      <!-- 工程模块 -->
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-api</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-case</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-domain</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-infrastructure</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-types</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>mcp-gateway-agent-trigger</artifactId>
        <version>1.0</version>
      </dependency>
      <!-- Observability Client SDK -->
      <dependency>
        <groupId>cn.chyuan.ai</groupId>
        <artifactId>agent-rag-observability-server-client</artifactId>
        <version>1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <!-- 依赖与构建环境门禁（SELFLOOP2 loop-228，试点成功后推广其他仓） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-convergence</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireUpperBoundDeps>
                  <!-- ADK/arrow 链跨大版本共存（okhttp 4↔5 等），需专项对齐批次处理，
                       试点期白名单（loop-228 记录，工单 0255/0256 Resolution 留档） -->
                  <excludes>
                    <exclude>com.squareup.okhttp3:okhttp</exclude>
                    <exclude>org.jetbrains:annotations</exclude>
                    <exclude>com.google.flatbuffers:flatbuffers-java</exclude>
                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                    <exclude>org.apache.arrow:arrow-format</exclude>
                    <exclude>com.squareup.okio:okio-jvm</exclude>
                    <!-- Jackson2/swagger 链（app 模块，springdoc 2.2.38 vs Boot 管理 2.21）：
                         loop-219 测试类路径 NoSuchFieldError 的根源，专项对齐批次处理 -->
                    <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</exclude>
                    <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</exclude>
                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                    <exclude>io.swagger.core.v3:swagger-annotations-jakarta</exclude>
                  </excludes>
                </requireUpperBoundDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- maven 脚手架 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <outputDirectory>${project.build.directory}/ai-agent-scaffold-lite-archetype</outputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>1.18.36</version>
            </path>
          <!-- b-24（工单 1144）：@ConfigurationProperties 元数据生成（C4 推广，承 b-17 agg） -->
          <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
          </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>2.5</version>
        <configuration>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>2.7</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <java_jvm>-Xms1G -Xmx1G -server -Xss256K -Dspring.profiles.active=dev -XX:+DisableExplicitGC -XX:+UseG1GC -XX:HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/export/Logs/ai-agent-scaffold-lite-boot -Xlog:gc*:file=/export/Logs/ai-agent-scaffold-lite-boot/gc-ai-agent-scaffold-lite-boot.log:time,uptime,level,tags</java_jvm>
        <profileActive>dev</profileActive>
      </properties>
    </profile>
    <profile>
      <id>test</id>
      <properties>
        <java_jvm>-Xms1G -Xmx1G -server -Xss256K -Dspring.profiles.active=test -XX:+DisableExplicitGC -XX:+UseG1GC -XX:HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/export/Logs/ai-agent-scaffold-lite-boot -Xlog:gc*:file=/export/Logs/ai-agent-scaffold-lite-boot/gc-ai-agent-scaffold-lite-boot.log:time,uptime,level,tags</java_jvm>
        <profileActive>test</profileActive>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties>
        <java_jvm>-Xms6G -Xmx6G -server -Xss256K -Dspring.profiles.active=release -XX:+DisableExplicitGC -XX:+UseG1GC -XX:HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/export/Logs/fq-mall-activity-app -Xlog:gc*:file=/export/Logs/ai-agent-scaffold-lite-boot/gc-ai-agent-scaffold-lite-boot.log:time,uptime,level,tags</java_jvm>
        <profileActive>prod</profileActive>
      </properties>
    </profile>
  </profiles>
  <modules>
    <module>mcp-gateway-agent-api</module>
    <module>mcp-gateway-agent-app</module>
    <module>mcp-gateway-agent-case</module>
    <module>mcp-gateway-agent-domain</module>
    <module>mcp-gateway-agent-trigger</module>
    <module>mcp-gateway-agent-infrastructure</module>
    <module>mcp-gateway-agent-types</module>
  </modules>
</project>
